{
  "name": "@signalflare-ai/sdk-codegen",
  "version": "0.0.0",
  "private": true,
  "description": "Shared OpenAPI SDK compiler for Signalflare products",
  "license": "MIT",
  "bin": {
    "signalflare-sdk": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "UPSTREAM.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effect-httpapi": {
      "types": "./dist/effect-httpapi/openapi.d.ts",
      "import": "./dist/effect-httpapi/openapi.js"
    }
  },
  "scripts": {
    "build": "bun run clean && bunx tsc -p tsconfig.build.json",
    "check": "bun run format && bun run lint && bun run typecheck && bun test",
    "clean": "rm -rf dist coverage",
    "format": "bunx oxfmt --check .",
    "format:fix": "bunx oxfmt --write .",
    "lint": "bunx oxlint --deny-warnings src test",
    "test": "bun test",
    "test:runtimes": "bash scripts/test-runtimes.sh",
    "test:atlas": "bash scripts/test-atlas.sh",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0",
    "@redocly/openapi-core": "2.47.0",
    "@workos/oagen": "0.29.2",
    "@workos/oagen-emitters": "0.24.4",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@socketsecurity/bun-security-scanner": "1.1.2",
    "@types/bun": "1.4.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.10.0"
  },
  "packageManager": "bun@1.4.0"
}
